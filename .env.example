# ============================================================
# 本文件由 setup.ps1 首次运行时自动生成随机值，一般无需手工编辑。
# 账号类凭据（Codex / OpenCode / Command Code）全部在管理台网页里填写：
#   http://localhost:8888  （一键应用后自动写回 new-api 与 cc-adapter）
# ============================================================

# cc-adapter 管理面板密码（manager 会自动用它，别删空）
CC_ADAPTER_ADMIN_PASSWORD=auto-generated-please-run-setup
# cc-adapter 网关访问密钥（new-api 的 CC 渠道用它）
CC_ADAPTER_ACCESS_KEY=sk-auto-generated-please-run-setup
# new-api 会话密钥
SESSION_SECRET=auto-generated-please-run-setup

# 可选：想绕过网页直接在 .env 预置 CC 密钥（网页里设置会覆盖这里）
# 支持 JSON 数组形式多 key：["k1","k2"]
# CC_ADAPTER_CC_API_KEY=